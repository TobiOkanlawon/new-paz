      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productCode\": \"\",\n  \"narration\": \"\",\n  \"interestRate\": \"\",\n  \"managementFee\": \"\",\n  \"adminFee\": \"\",\n  \"productName\": \"\",\n  \"tenor\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/loan/loan-product-creation",
          "host": ["{{base_url}}"],
          "path": ["v1", "loan", "loan-product-creation"]
        }
      }
    },
    {
      "name": "Update Loan Product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
