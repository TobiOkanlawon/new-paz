{
  "info": {
    "name": "Loan API",
    "description": "Collection of loan-related endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000"
    }
  ],
